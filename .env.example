# Copy this file to ".env" and fill it in.  NEVER commit ".env" (it is in .gitignore).
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

# "development" for your own computer, "production" on a server.
# In production the app refuses to start without SECRET_KEY and only sends cookies over HTTPS.
APP_ENV=development

# Signs the login cookie. Use a long random value in production, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everybody out.
SECRET_KEY=change-me-to-a-long-random-string

# Dates such as "today" are calculated in this timezone (servers usually run in UTC).
APP_TIMEZONE=Africa/Johannesburg

# Where the server listens. Hosting platforms usually set PORT for you.
HOST=127.0.0.1
PORT=5000

# 1 = auto-reload and debug pages. Only on your own computer, never on a server.
FLASK_DEBUG=0

# Not used yet: the data is kept in memory. Reserved for the MySQL connection when it is added.
# DATABASE_URL=mysql://user:password@localhost:3306/ltsm
